generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPERADMIN
}

enum WorkspaceRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Profile avatar icon (optional)
  avatarIcon String? @db.VarChar(40)

  // Credentials auth (optional)
  passwordHash String? @db.VarChar(255)

  // Profile
  birthDate DateTime?

  // Session policy (JWT)
  // If null, use the system default.
  sessionMaxAgeSec     Int?
  sessionPolicyVersion Int  @default(0)

  // Basic access control
  role   UserRole @default(USER)
  active Boolean  @default(true)

  accounts Account[]
  sessions Session[]

  memberships        WorkspaceMember[]
  workspaceUserRoles WorkspaceUserRole[]
  salesOrders        SalesOrder[]        @relation("SalesOrderOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id      String            @id @default(cuid())
  name    String
  members WorkspaceMember[]

  createdById String?
  updatedById String?

  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
  clients        Client[]
  products       Product[]
  inventories    Inventory[]
  purchases      Purchase[]
  consumptions   Consumption[]
  recipes        Recipe[]

  // Logistics + Finance (sales flow)
  deliveries          Delivery[]
  receivables         Receivable[]
  payments            Payment[]
  paymentApplications PaymentApplication[]
  refunds             Refund[]

  // Finance (MVP)
  financialEntries    FinancialEntry[]
  financialAccounts   FinancialAccount[]
  financialCategories FinancialCategory[]
  costCenters         CostCenter[]

  sequences WorkspaceSequence[]

  // Admin
  userInviteTokens UserInviteToken[]
  roles            WorkspaceRoleModel[]
  userRoles        WorkspaceUserRole[]
  rolePermissions  WorkspaceRolePermission[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspaceSettings WorkspaceSetting[]
  auditEvents       AuditEvent[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(USER)

  createdById String?
  updatedById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions WorkspaceRolePermission[]
}

model WorkspaceRoleModel {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isSystem    Boolean @default(false)

  createdById String?
  updatedById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  permissions WorkspaceRolePermission[]
  userRoles   WorkspaceUserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model WorkspaceRolePermission {
  id           String   @id @default(cuid())
  workspaceId  String
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role       WorkspaceRoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([workspaceId])
}

model WorkspaceUserRole {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  roleId      String

  createdById String?

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      WorkspaceRoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // One custom role per user per workspace
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model UserInviteToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  workspaceId   String
  workspaceRole WorkspaceRole @default(USER)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // who invited (for audit)
  createdById String?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([workspaceId])
  @@index([expiresAt])
}

// ============================
// Sales (Pedidos de Venda)
// ============================

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY
  SHIPPED
  DONE
  CANCELLED
}

enum SalesOrderDiscountMode {
  SUBTOTAL
  PER_ITEM
}

enum DiscountType {
  VALUE
  PERCENT
}

model SalesOrder {
  id          String @id @default(cuid())
  workspaceId String
  ownerId     String

  // Human-friendly code (e.g. SO-20260316-AB12)
  code String? @db.VarChar(32)

  createdById String?
  updatedById String?

  name         String
  observations String?

  clientId String?

  orderedAt  DateTime? // data do pedido
  deliveryAt DateTime? // data prevista de entrega

  status SalesOrderStatus @default(DRAFT)

  // Desconto (um tipo por vez). Aplicação pode ser no subtotal do pedido ou por item.
  discountMode    SalesOrderDiscountMode @default(SUBTOTAL)
  discountType    DiscountType? // VALUE | PERCENT
  discountValue   Decimal?               @db.Decimal(12, 2)
  discountPercent Decimal?               @db.Decimal(5, 2)

  // Valor final do pedido (subtotal - desconto)
  value Decimal? @db.Decimal(12, 2)

  // Manual ordering within a view/list (optional)
  orderIndex String? @db.VarChar(64)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation("SalesOrderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  items            SalesOrderItem[]
  deliveries       Delivery[]
  payments         Payment[]
  receivables      Receivable[]
  consumptions     Consumption[]
  financialEntries FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refunds   Refund[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([ownerId])
  @@index([deliveryAt])
  @@index([orderedAt])
  @@index([clientId])
}

model SalesOrderItem {
  id           String @id @default(cuid())
  salesOrderId String
  productId    String

  createdById String?
  updatedById String?

  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(12, 2)

  // Used when SalesOrder.discountMode = PER_ITEM (one type at a time)
  discountType    DiscountType?
  discountValue   Decimal?      @db.Decimal(12, 2)
  discountPercent Decimal?      @db.Decimal(5, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([salesOrderId, productId])
  @@index([salesOrderId])
  @@index([productId])
}

// ============================
// Procurement (Pedidos de Compra)
// ============================

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED // pedido confirmado/enviado ao fornecedor (sem entrada em estoque)
  RECEIVED // recebido: dá entrada no estoque + atualiza custo médio
  CANCELLED
}

model PurchaseOrder {
  id          String @id @default(cuid())
  workspaceId String

  // Human-friendly code (e.g. PO-20260316-AB12)
  code String? @db.VarChar(32)

  createdById String?
  updatedById String?

  // Fornecedor: preferencialmente via stakeholder (Client). Mantemos `supplier` como fallback textual.
  supplierId String?
  supplier   String?

  orderedAt DateTime? // data do pedido

  status PurchaseOrderStatus @default(DRAFT)

  // When status becomes RECEIVED
  receivedAt DateTime?

  observations String?

  // Valor estimado do pedido de compra
  estimatedCost Decimal? @db.Decimal(12, 2)

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplierEntity Client?   @relation("PurchaseOrderSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  items            PurchaseOrderItem[]
  financialEntries FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([orderedAt])
  @@index([status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String

  createdById String?
  updatedById String?

  quantity Decimal  @db.Decimal(14, 3)
  unitCost Decimal? @db.Decimal(12, 2) // custo unitário de entrada (ex.: 3.50)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId])
  @@index([productId])
}

enum StakeholderRole {
  CUSTOMER
  SUPPLIER
}

enum ClientEntityType {
  PERSON // PF
  COMPANY // PJ
}

model Client {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  name String

  // PF/PJ
  entityType ClientEntityType @default(PERSON)

  // Roles: allows using a single table for customers and suppliers (and both)
  roles StakeholderRole[] @default([CUSTOMER])

  // Contact
  // NOTE: We are standardizing on E.164 in `phone` (e.g. +351912345678)
  phone        String?
  phoneCountry String? @db.VarChar(2) // ISO-2 (PT, BR, ...)
  email        String? @db.VarChar(254)

  // Personal
  birthDate DateTime? @db.Date

  // Identification (MVP: single primary document)
  idType    String? @db.VarChar(32) // e.g. TAX_ID | NATIONAL_ID | PASSPORT | DRIVER_LICENSE | RESIDENCE_PERMIT | COMPANY_ID | OTHER
  idNumber  String? @db.VarChar(64)
  idCountry String? @db.VarChar(2) // ISO-2

  // Address (structured)
  addressCountry    String? @db.VarChar(2) // ISO-2
  addressPostalCode String? @db.VarChar(16)
  addressState      String? @db.VarChar(80)
  addressCity       String? @db.VarChar(120)
  addressDistrict   String? @db.VarChar(120)
  addressStreet     String? @db.VarChar(180)
  addressNumber     String? @db.VarChar(32)
  addressComplement String? @db.VarChar(180)

  // Legacy free-form address (kept for backward compatibility)
  address      String?
  observations String?

  workspace                Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrders              SalesOrder[]
  purchaseOrdersAsSupplier PurchaseOrder[] @relation("PurchaseOrderSupplier")

  payments    Payment[]
  receivables Receivable[]
  deliveries  Delivery[]
  refunds     Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([phone])
}

// Portugal postal code mapping (free/local dataset)
model PostalPt {
  cp4 String @db.VarChar(4)
  cp3 String @db.VarChar(3)

  distrito   String  @db.VarChar(80)
  concelho   String  @db.VarChar(120)
  localidade String? @db.VarChar(180)

  // optional: keep original raw line/source if needed later
  // source String?

  @@id([cp4, cp3, distrito, concelho])
  @@index([cp4, cp3])
  @@index([distrito])
  @@index([concelho])
}

enum ProductKind {
  RAW
  INTERMEDIATE
  FINISHED
}

model Product {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  name   String
  brand  String?
  kind   ProductKind @default(RAW)
  unit   String // unidade padrão (ex.: gr, kg, ml, un)
  active Boolean     @default(true)

  // Custo médio (média ponderada) em moeda do workspace
  avgCost Decimal? @db.Decimal(12, 2)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  inventory       Inventory?
  salesOrderItems SalesOrderItem[]
  purchases       Purchase[]
  consumptions    Consumption[]
  recipeItems     RecipeItem[]
  recipesAsFinal  Recipe[]         @relation("RecipeProductFinal")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  purchaseOrderItems PurchaseOrderItem[]
  deliveryItems      DeliveryItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Inventory {
  id          String @id @default(cuid())
  workspaceId String
  productId   String @unique

  createdById String?
  updatedById String?

  quantity Decimal  @db.Decimal(14, 3)
  minimum  Decimal? @db.Decimal(14, 3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model Purchase {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  productId    String
  date         DateTime @default(now())
  quantity     Decimal  @db.Decimal(14, 3)
  cost         Decimal? @db.Decimal(12, 2)
  supplier     String?
  observations String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  financialEntries FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([productId])
  @@index([date])
}

model Consumption {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  date      DateTime @default(now())
  productId String
  quantity  Decimal  @db.Decimal(14, 3)

  salesOrderId String?
  recipeId     String?
  observations String?

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  recipe     Recipe?     @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  financialEntries FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([productId])
  @@index([date])
  @@index([salesOrderId])
  @@index([recipeId])
}

model Recipe {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  productId    String // produto final
  yieldQty     Decimal? @db.Decimal(14, 3)
  observations String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation("RecipeProductFinal", fields: [productId], references: [id], onDelete: Restrict)

  items        RecipeItem[]
  consumptions Consumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([productId])
}

model RecipeItem {
  id        String @id @default(cuid())
  recipeId  String
  productId String // insumo

  createdById String?
  updatedById String?

  quantity Decimal @db.Decimal(14, 3)

  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([recipeId, productId])
  @@index([recipeId])
  @@index([productId])
}

enum FinancialEntryType {
  IN
  OUT
}

enum FinancialEntryStatus {
  PLANNED
  PAID
}

model FinancialAccount {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  name   String
  kind   String  @default("CASH") // CASH | BANK | CARD | OTHER
  active Boolean @default(true)

  openingBalance Decimal? @db.Decimal(12, 2)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FinancialCategory {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  name   String
  type   FinancialEntryType
  active Boolean            @default(true)

  parentId String?
  parent   FinancialCategory?  @relation("FinancialCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children FinancialCategory[] @relation("FinancialCategoryParent")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name, type])
  @@index([workspaceId])
  @@index([type])
}

model CostCenter {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  name   String
  active Boolean @default(true)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model WorkspaceSequence {
  workspaceId String
  key         String
  next        Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
  @@index([workspaceId])
}

enum AuditCategory {
  CRUD
  PERMISSIONS
  AUTH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  GRANT
  REVOKE
}

model WorkspaceSetting {
  workspaceId String
  key         String
  value       Json

  updatedById String?
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
  @@index([workspaceId])
}

model AuditEvent {
  id          String @id @default(cuid())
  workspaceId String

  category AuditCategory
  action   AuditAction

  // Actor (who performed the action)
  actorUserId String?

  // Optional target user (e.g. permission changes)
  targetUserId String?

  // Optional target entity (CRUD)
  entityType String?
  entityId   String?

  // A short message used in lists
  summary String?

  meta Json?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  changes AuditEventChange[]

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, category, createdAt])
  @@index([workspaceId, actorUserId, createdAt])
  @@index([workspaceId, entityType, entityId, createdAt])
}

model AuditEventChange {
  id      String @id @default(cuid())
  eventId String

  field String
  from  Json?
  to    Json?

  event AuditEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, field])
}

model FinancialEntry {
  id          String @id @default(cuid())
  workspaceId String

  // Human-friendly sequential code (e.g. FIN-0000000001) unique per workspace
  code String? @db.VarChar(16)

  // Human-friendly name/title for the entry (used in UI)
  name String? @db.VarChar(200)

  createdById String?
  updatedById String?

  // Competência (quando ocorreu) vs pagamento (quando efetivou)
  competenceDate DateTime  @default(now())
  paidAt         DateTime?

  type   FinancialEntryType
  status FinancialEntryStatus @default(PAID)

  accountId    String
  categoryId   String?
  costCenterId String?

  value        Decimal @db.Decimal(12, 2)
  observations String?

  salesOrderId    String?
  purchaseId      String?
  purchaseOrderId String?
  consumptionId   String?

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account    FinancialAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category   FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenter CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  salesOrder    SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  purchase      Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  consumption   Consumption?   @relation(fields: [consumptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([competenceDate])
  @@index([paidAt])
  @@index([type])
  @@index([status])
  @@index([accountId])
  @@index([categoryId])
  @@index([costCenterId])
  @@index([salesOrderId])
  @@index([purchaseId])
  @@index([purchaseOrderId])
  @@index([consumptionId])
}

// NextAuth models (Prisma schema from Auth.js/NextAuth docs)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================
// Deliveries + Receivables + Payments (Sales flow)
// ============================

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum DeliveryStatus {
  PLANNED
  PICKING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model Delivery {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  salesOrderId String
  clientId     String?

  status DeliveryStatus @default(PLANNED)

  method DeliveryMethod @default(PICKUP)

  plannedAt   DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?

  carrier      String?
  trackingCode String?
  trackingUrl  String?
  observations String?

  // Snapshot do endereço de entrega (quando method=DELIVERY)
  addressCountry    String? @db.VarChar(2)
  addressPostalCode String? @db.VarChar(16)
  addressState      String? @db.VarChar(80)
  addressCity       String? @db.VarChar(120)
  addressDistrict   String? @db.VarChar(120)
  addressStreet     String? @db.VarChar(180)
  addressNumber     String? @db.VarChar(40)
  addressComplement String? @db.VarChar(120)
  addressNotes      String? @db.VarChar(500)

  // Valor a faturar por esta expedição (MVP). Evita precisar de preço por item agora.
  value Decimal? @db.Decimal(12, 2)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  items      DeliveryItem[]
  receivable Receivable?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([salesOrderId])
  @@index([clientId])
  @@index([status])
  @@index([plannedAt])
  @@index([shippedAt])
  @@index([deliveredAt])
}

model DeliveryItem {
  id         String @id @default(cuid())
  deliveryId String
  productId  String

  createdById String?
  updatedById String?

  quantity Decimal @db.Decimal(14, 3)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([deliveryId, productId])
  @@index([deliveryId])
  @@index([productId])
}

enum ReceivableStatus {
  OPEN
  PAID
  CANCELLED
}

model Receivable {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  salesOrderId String
  deliveryId   String  @unique
  clientId     String?

  status ReceivableStatus @default(OPEN)

  issuedAt DateTime  @default(now())
  dueAt    DateTime?

  value Decimal @db.Decimal(12, 2)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  delivery   Delivery   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  applications PaymentApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([salesOrderId])
  @@index([clientId])
  @@index([status])
  @@index([issuedAt])
  @@index([dueAt])
}

enum PaymentMethod {
  CASH
  TRANSFER
  MBWAY
  PIX
  CARD
  OTHER
}

enum PaymentStatus {
  RECEIVED
  REFUNDED
  FAILED
}

model Payment {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  salesOrderId String
  clientId     String?

  method PaymentMethod
  status PaymentStatus @default(RECEIVED)

  receivedAt DateTime @default(now())

  value Decimal @db.Decimal(12, 2)

  reference    String?
  proofUrl     String?
  observations String?

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  applications PaymentApplication[]
  refunds      Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([salesOrderId])
  @@index([clientId])
  @@index([method])
  @@index([status])
  @@index([receivedAt])
}

model PaymentApplication {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  paymentId    String
  receivableId String

  appliedAt DateTime @default(now())
  value     Decimal  @db.Decimal(12, 2)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment    Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@unique([paymentId, receivableId])
  @@index([workspaceId])
  @@index([paymentId])
  @@index([receivableId])
  @@index([appliedAt])
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  DONE
  FAILED
}

enum RefundMethod {
  CARD_REVERSAL
  TRANSFER
  PIX
  MBWAY
  CASH
  OTHER
}

model Refund {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  salesOrderId String
  clientId     String?

  paymentId String?

  status RefundStatus @default(REQUESTED)
  method RefundMethod

  requestedAt DateTime  @default(now())
  completedAt DateTime?

  value Decimal @db.Decimal(12, 2)

  reason       String?
  reference    String?
  proofUrl     String?
  observations String?

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  payment    Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([salesOrderId])
  @@index([clientId])
  @@index([paymentId])
  @@index([status])
  @@index([requestedAt])
  @@index([completedAt])
}
