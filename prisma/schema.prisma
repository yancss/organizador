generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Credentials auth (optional)
  passwordHash String? @db.VarChar(255)

  // Profile
  birthDate DateTime?

  // Basic access control
  role   String  @default("user")
  active Boolean @default(true)

  accounts Account[]
  sessions Session[]

  memberships WorkspaceMember[]
  salesOrders SalesOrder[]      @relation("SalesOrderOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id      String            @id @default(cuid())
  name    String
  members WorkspaceMember[]

  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
  clients        Client[]
  products       Product[]
  inventories    Inventory[]
  purchases      Purchase[]
  consumptions   Consumption[]
  recipes        Recipe[]

  // Finance (MVP)
  financialEntries    FinancialEntry[]
  financialAccounts   FinancialAccount[]
  financialCategories FinancialCategory[]
  costCenters         CostCenter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMember {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  role        String @default("owner")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

// ============================
// Sales (Pedidos de Venda)
// ============================

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model SalesOrder {
  id          String @id @default(cuid())
  workspaceId String
  ownerId     String

  name         String
  observations String?

  clientId String?

  orderedAt  DateTime? // data do pedido
  deliveryAt DateTime? // data prevista de entrega

  status SalesOrderStatus @default(DRAFT)

  // Valor “combinado” no pedido (pode ser recalculado via itens no futuro)
  value Decimal? @db.Decimal(12, 2)

  // Manual ordering within a view/list (optional)
  orderIndex String? @db.VarChar(64)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation("SalesOrderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  items            SalesOrderItem[]
  consumptions     Consumption[]
  financialEntries FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([ownerId])
  @@index([deliveryAt])
  @@index([orderedAt])
  @@index([clientId])
}

model SalesOrderItem {
  id           String @id @default(cuid())
  salesOrderId String
  productId    String

  quantity Decimal @db.Decimal(14, 3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([salesOrderId, productId])
  @@index([salesOrderId])
  @@index([productId])
}

// ============================
// Procurement (Pedidos de Compra)
// ============================

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model PurchaseOrder {
  id          String @id @default(cuid())
  workspaceId String

  // MVP: fornecedor em texto; depois podemos normalizar em tabela Supplier
  supplier String?

  orderedAt DateTime? // data do pedido

  status PurchaseOrderStatus @default(DRAFT)

  observations String?

  // Valor estimado do pedido de compra
  estimatedCost Decimal? @db.Decimal(12, 2)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([orderedAt])
  @@index([status])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String

  quantity Decimal @db.Decimal(14, 3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId])
  @@index([productId])
}

model Client {
  id          String @id @default(cuid())
  workspaceId String

  name String

  // Contact
  // NOTE: We are standardizing on E.164 in `phone` (e.g. +351912345678)
  phone        String?
  phoneCountry String? @db.VarChar(2) // ISO-2 (PT, BR, ...)

  // Personal
  birthDate DateTime? @db.Date

  // Identification (MVP: single primary document)
  idType    String? @db.VarChar(32) // e.g. TAX_ID | NATIONAL_ID | PASSPORT | DRIVER_LICENSE | RESIDENCE_PERMIT | COMPANY_ID | OTHER
  idNumber  String? @db.VarChar(64)
  idCountry String? @db.VarChar(2) // ISO-2

  // Address (structured)
  addressCountry    String? @db.VarChar(2) // ISO-2
  addressPostalCode String? @db.VarChar(16)
  addressState      String? @db.VarChar(80)
  addressCity       String? @db.VarChar(120)
  addressDistrict   String? @db.VarChar(120)
  addressStreet     String? @db.VarChar(180)
  addressNumber     String? @db.VarChar(32)
  addressComplement String? @db.VarChar(180)

  // Legacy free-form address (kept for backward compatibility)
  address      String?
  observations String?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrders SalesOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([phone])
}

enum ProductKind {
  RAW
  FINISHED
}

model Product {
  id          String @id @default(cuid())
  workspaceId String

  name   String
  brand  String?
  kind   ProductKind @default(RAW)
  unit   String // unidade padrão (ex.: gr, kg, ml, un)
  active Boolean     @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  inventory       Inventory?
  salesOrderItems SalesOrderItem[]
  purchases       Purchase[]
  consumptions    Consumption[]
  recipeItems     RecipeItem[]
  recipesAsFinal  Recipe[]         @relation("RecipeProductFinal")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Inventory {
  id          String @id @default(cuid())
  workspaceId String
  productId   String @unique

  quantity Decimal  @db.Decimal(14, 3)
  minimum  Decimal? @db.Decimal(14, 3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model Purchase {
  id          String @id @default(cuid())
  workspaceId String

  productId    String
  date         DateTime @default(now())
  quantity     Decimal  @db.Decimal(14, 3)
  cost         Decimal? @db.Decimal(12, 2)
  supplier     String?
  observations String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  financialEntries FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([productId])
  @@index([date])
}

model Consumption {
  id          String @id @default(cuid())
  workspaceId String

  date      DateTime @default(now())
  productId String
  quantity  Decimal  @db.Decimal(14, 3)

  salesOrderId String?
  recipeId     String?
  observations String?

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  recipe     Recipe?     @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  financialEntries FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([productId])
  @@index([date])
  @@index([salesOrderId])
  @@index([recipeId])
}

model Recipe {
  id          String @id @default(cuid())
  workspaceId String

  productId    String // produto final
  yieldQty     Decimal? @db.Decimal(14, 3)
  observations String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation("RecipeProductFinal", fields: [productId], references: [id], onDelete: Restrict)

  items        RecipeItem[]
  consumptions Consumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([productId])
}

model RecipeItem {
  id        String @id @default(cuid())
  recipeId  String
  productId String // insumo

  quantity Decimal @db.Decimal(14, 3)

  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([recipeId, productId])
  @@index([recipeId])
  @@index([productId])
}

enum FinancialEntryType {
  IN
  OUT
}

enum FinancialEntryStatus {
  PLANNED
  PAID
}

model FinancialAccount {
  id          String @id @default(cuid())
  workspaceId String

  name   String
  kind   String  @default("CASH") // CASH | BANK | CARD | OTHER
  active Boolean @default(true)

  openingBalance Decimal? @db.Decimal(12, 2)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FinancialCategory {
  id          String @id @default(cuid())
  workspaceId String

  name   String
  type   FinancialEntryType
  active Boolean            @default(true)

  parentId String?
  parent   FinancialCategory?  @relation("FinancialCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children FinancialCategory[] @relation("FinancialCategoryParent")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name, type])
  @@index([workspaceId])
  @@index([type])
}

model CostCenter {
  id          String @id @default(cuid())
  workspaceId String

  name   String
  active Boolean @default(true)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FinancialEntry {
  id          String @id @default(cuid())
  workspaceId String

  // Competência (quando ocorreu) vs pagamento (quando efetivou)
  competenceDate DateTime  @default(now())
  paidAt         DateTime?

  type   FinancialEntryType
  status FinancialEntryStatus @default(PAID)

  accountId    String
  categoryId   String?
  costCenterId String?

  value        Decimal @db.Decimal(12, 2)
  observations String?

  salesOrderId  String?
  purchaseId    String?
  consumptionId String?

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account    FinancialAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category   FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenter CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  salesOrder  SalesOrder?  @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  purchase    Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  consumption Consumption? @relation(fields: [consumptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([competenceDate])
  @@index([paidAt])
  @@index([type])
  @@index([status])
  @@index([accountId])
  @@index([categoryId])
  @@index([costCenterId])
  @@index([salesOrderId])
  @@index([purchaseId])
  @@index([consumptionId])
}

// NextAuth models (Prisma schema from Auth.js/NextAuth docs)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
