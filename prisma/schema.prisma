generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================
// Fiscal (multinational skeleton)
// ============================

// Limited set for now; designed to expand.
enum CountryCode {
  BR
  PT
  ES
}

enum TaxIdType {
  CNPJ
  CPF
  NIF
  CIF
}

enum CompanyBranchType {
  HQ
  BRANCH
}

enum FiscalDocumentKind {
  SALE
  PURCHASE
  SERVICE
}

enum FiscalDocumentStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum BrNfeEnvironment {
  HOMOLOGATION
  PRODUCTION
}

enum BrNfeStatus {
  DRAFT
  PENDING_TRANSMISSION
  AUTHORIZED
  REJECTED
  CANCELLED
}

enum UserRole {
  USER
  SUPERADMIN
}

enum WorkspaceRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Profile avatar icon (optional)
  avatarIcon String? @db.VarChar(40)

  // Credentials auth (optional)
  passwordHash String? @db.VarChar(255)

  // Profile
  birthDate DateTime?

  // Session policy (JWT)
  // If null, use the system default.
  sessionMaxAgeSec     Int?
  sessionPolicyVersion Int  @default(0)

  // Basic access control
  role   UserRole @default(USER)
  active Boolean  @default(true)

  accounts Account[]
  sessions Session[]

  memberships        WorkspaceMember[]
  workspaceUserRoles WorkspaceUserRole[]
  salesOrders        SalesOrder[]        @relation("SalesOrderOwner")
  salesQuotes        SalesQuote[]        @relation("SalesQuoteOwner")
  requestedApprovals ApprovalRequest[]   @relation("ApprovalRequestedBy")
  decidedApprovals   ApprovalRequest[]   @relation("ApprovalDecidedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id      String            @id @default(cuid())
  name    String
  members WorkspaceMember[]

  createdById String?
  updatedById String?

  salesOrders     SalesOrder[]
  salesQuotes     SalesQuote[]
  purchaseOrders  PurchaseOrder[]
  clients         Client[]
  products        Product[]
  productBarcodes ProductBarcode[]
  inventories     Inventory[]
  inventoryMovements InventoryMovement[]
  inventoryLots   InventoryLot[]
  warehouses      Warehouse[]
  inventoryByWarehouse InventoryByWarehouse[]
  inventoryTransfers InventoryTransfer[]
  purchases       Purchase[]
  consumptions    Consumption[]
  recipes         Recipe[]

  // Logistics + Finance (sales flow)
  deliveries          Delivery[]
  receivables         Receivable[]
  payments            Payment[]
  paymentApplications PaymentApplication[]
  refunds             Refund[]
  payables            Payable[]
  approvalRequests    ApprovalRequest[]

  // Finance (MVP)
  financialEntries    FinancialEntry[]
  financialAccounts   FinancialAccount[]
  financialCategories FinancialCategory[]
  costCenters         CostCenter[]

  sequences WorkspaceSequence[]

  // Admin
  userInviteTokens UserInviteToken[]
  roles            WorkspaceRoleModel[]
  userRoles        WorkspaceUserRole[]
  rolePermissions  WorkspaceRolePermission[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspaceSettings WorkspaceSetting[]
  auditEvents       AuditEvent[]

  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]

  // Fiscal
  companies           Company[]
  companyBranches     CompanyBranch[]
  fiscalDocuments     FiscalDocument[]
  fiscalDocumentLines FiscalDocumentLine[]
  brNfes              BrNfe[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(USER)

  createdById String?
  updatedById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions WorkspaceRolePermission[]
}

model WorkspaceRoleModel {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isSystem    Boolean @default(false)

  createdById String?
  updatedById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  permissions WorkspaceRolePermission[]
  userRoles   WorkspaceUserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model WorkspaceRolePermission {
  id           String   @id @default(cuid())
  workspaceId  String
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role       WorkspaceRoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([workspaceId])
}

model WorkspaceUserRole {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  roleId      String

  createdById String?

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      WorkspaceRoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // One custom role per user per workspace
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model UserInviteToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  workspaceId   String
  workspaceRole WorkspaceRole @default(USER)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // who invited (for audit)
  createdById String?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([workspaceId])
  @@index([expiresAt])
}

// ============================
// Sales (Pedidos de Venda)
// ============================

enum SalesOrderStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONFIRMED
  IN_PRODUCTION
  READY
  SHIPPED
  DONE
  CANCELLED
}

enum SalesOrderDiscountMode {
  SUBTOTAL
  PER_ITEM
}

enum SalesQuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum DiscountType {
  VALUE
  PERCENT
}

model SalesOrder {
  id          String @id @default(cuid())
  workspaceId String
  ownerId     String

  // Human-friendly code (e.g. SO-20260316-AB12)
  code String? @db.VarChar(32)

  createdById String?
  updatedById String?

  name         String
  observations String?

  clientId String?

  orderedAt  DateTime? // data do pedido
  deliveryAt DateTime? // data prevista de entrega

  status SalesOrderStatus @default(DRAFT)

  // Desconto (um tipo por vez). Aplicação pode ser no subtotal do pedido ou por item.
  discountMode    SalesOrderDiscountMode @default(SUBTOTAL)
  discountType    DiscountType? // VALUE | PERCENT
  discountValue   Decimal?               @db.Decimal(12, 2)
  discountPercent Decimal?               @db.Decimal(5, 2)

  // Valor final do pedido (subtotal - desconto)
  value Decimal? @db.Decimal(12, 2)

  // Manual ordering within a view/list (optional)
  orderIndex String? @db.VarChar(64)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation("SalesOrderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  items            SalesOrderItem[]
  deliveries       Delivery[]
  payments         Payment[]
  receivables      Receivable[]
  consumptions     Consumption[]
  financialEntries FinancialEntry[]
  approvalRequests ApprovalRequest[]

  // Orçamento de origem (F2-02), quando o pedido nasceu de uma conversão
  sourceQuote SalesQuote? @relation("SalesOrderFromQuote")

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  refunds         Refund[]
  fiscalDocuments FiscalDocument[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([ownerId])
  @@index([deliveryAt])
  @@index([orderedAt])
  @@index([clientId])
}

model SalesOrderItem {
  id           String @id @default(cuid())
  salesOrderId String
  productId    String

  createdById String?
  updatedById String?

  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(12, 2)

  // Used when SalesOrder.discountMode = PER_ITEM (one type at a time)
  discountType    DiscountType?
  discountValue   Decimal?      @db.Decimal(12, 2)
  discountPercent Decimal?      @db.Decimal(5, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([salesOrderId, productId])
  @@index([salesOrderId])
  @@index([productId])
}

// ============================
// Comercial — Orçamento / Proposta (F2-01)
// ============================

model SalesQuote {
  id          String @id @default(cuid())
  workspaceId String
  ownerId     String

  // Código sequencial por workspace (ex.: QUO-0000000001)
  code String? @db.VarChar(32)

  createdById String?
  updatedById String?

  name         String
  observations String?

  clientId String?

  validUntil DateTime?

  status SalesQuoteStatus @default(DRAFT)

  discountMode    SalesOrderDiscountMode @default(SUBTOTAL)
  discountType    DiscountType?
  discountValue   Decimal?               @db.Decimal(12, 2)
  discountPercent Decimal?               @db.Decimal(5, 2)

  // Valor final (subtotal - desconto)
  value Decimal? @db.Decimal(12, 2)

  sentAt         DateTime?
  decidedAt      DateTime?
  decidedById    String?
  convertedAt    DateTime?
  reminderSentAt DateTime?

  // Pedido gerado na conversão (F2-02)
  salesOrderId String? @unique

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User        @relation("SalesQuoteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  salesOrder  SalesOrder? @relation("SalesOrderFromQuote", fields: [salesOrderId], references: [id], onDelete: SetNull)

  items            SalesQuoteItem[]
  approvalRequests ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([ownerId])
  @@index([clientId])
  @@index([status])
  @@index([validUntil])
}

model SalesQuoteItem {
  id           String @id @default(cuid())
  salesQuoteId String
  productId    String

  createdById String?
  updatedById String?

  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(12, 2)

  discountType    DiscountType?
  discountValue   Decimal?      @db.Decimal(12, 2)
  discountPercent Decimal?      @db.Decimal(5, 2)

  salesQuote SalesQuote @relation(fields: [salesQuoteId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([salesQuoteId, productId])
  @@index([salesQuoteId])
  @@index([productId])
}

// ============================
// Procurement (Pedidos de Compra)
// ============================

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED // pedido confirmado/enviado ao fornecedor (sem entrada em estoque)
  PARTIALLY_RECEIVED // recebido parcialmente: parte entrou no estoque e parte segue pendente
  RECEIVED // recebido: dá entrada no estoque + atualiza custo médio
  CANCELLED
}

model PurchaseOrder {
  id          String @id @default(cuid())
  workspaceId String

  // Human-friendly code (e.g. PO-20260316-AB12)
  code String? @db.VarChar(32)

  createdById String?
  updatedById String?

  // Fornecedor: preferencialmente via stakeholder (Client). Mantemos `supplier` como fallback textual.
  supplierId String?
  supplier   String?

  orderedAt DateTime? // data do pedido

  status PurchaseOrderStatus @default(DRAFT)

  // When status becomes RECEIVED
  receivedAt DateTime?

  observations String?

  // Valor estimado do pedido de compra
  estimatedCost Decimal? @db.Decimal(12, 2)

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplierEntity Client?   @relation("PurchaseOrderSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  items            PurchaseOrderItem[]
  inventoryLots    InventoryLot[]
  financialEntries FinancialEntry[]
  payables         Payable[]
  approvalRequests ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([orderedAt])
  @@index([status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String

  createdById String?
  updatedById String?

  quantity Decimal  @db.Decimal(14, 3)
  receivedQty Decimal @default(0) @db.Decimal(14, 3)
  acceptedQty Decimal @default(0) @db.Decimal(14, 3)
  rejectedQty Decimal @default(0) @db.Decimal(14, 3)
  receiptObservation String?
  unitCost Decimal? @db.Decimal(12, 2) // custo unitário de entrada (ex.: 3.50)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId])
  @@index([productId])
}

enum StakeholderRole {
  CUSTOMER
  SUPPLIER
}

enum ClientEntityType {
  PERSON // PF
  COMPANY // PJ
}

enum SupplierWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Client {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  name String

  // PF/PJ
  entityType ClientEntityType @default(PERSON)

  // Roles: allows using a single table for customers and suppliers (and both)
  roles StakeholderRole[] @default([CUSTOMER])

  // Contact
  // NOTE: We are standardizing on E.164 in `phone` (e.g. +351912345678)
  phone        String?
  phoneCountry String? @db.VarChar(2) // ISO-2 (PT, BR, ...)
  email        String? @db.VarChar(254)

  // Personal
  birthDate DateTime? @db.Date

  // Identification (MVP: single primary document)
  idType    String? @db.VarChar(32) // e.g. TAX_ID | NATIONAL_ID | PASSPORT | DRIVER_LICENSE | RESIDENCE_PERMIT | COMPANY_ID | OTHER
  idNumber  String? @db.VarChar(64)
  idCountry String? @db.VarChar(2) // ISO-2

  // Address (structured)
  addressCountry    String? @db.VarChar(2) // ISO-2
  addressPostalCode String? @db.VarChar(16)
  addressState      String? @db.VarChar(80)
  addressCity       String? @db.VarChar(120)
  addressDistrict   String? @db.VarChar(120)
  addressStreet     String? @db.VarChar(180)
  addressNumber     String? @db.VarChar(32)
  addressComplement String? @db.VarChar(180)

  // Legacy free-form address (kept for backward compatibility)
  address      String?
  observations String?
  supplierOrderDays    SupplierWeekday[] @default([])
  supplierDeliveryDays SupplierWeekday[] @default([])
    supplierOrderCutoffHour Int?
    supplierBlockedDates String[] @default([])
    supplierMinOrderValue Decimal? @db.Decimal(12, 2)

    workspace                Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    salesOrders              SalesOrder[]
    salesQuotes              SalesQuote[]
    purchaseOrdersAsSupplier PurchaseOrder[] @relation("PurchaseOrderSupplier")
    preferredInventoryItems  Inventory[]     @relation("InventoryPreferredSupplier")
    inventoryLots            InventoryLot[]
    payables                 Payable[]

  payments    Payment[]
  receivables Receivable[]
  deliveries  Delivery[]
  refunds     Refund[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  fiscalDocuments FiscalDocument[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([phone])
}

// Portugal postal code mapping (free/local dataset)
model PostalPt {
  cp4 String @db.VarChar(4)
  cp3 String @db.VarChar(3)

  distrito   String  @db.VarChar(80)
  concelho   String  @db.VarChar(120)
  localidade String? @db.VarChar(180)

  // optional: keep original raw line/source if needed later
  // source String?

  @@id([cp4, cp3, distrito, concelho])
  @@index([cp4, cp3])
  @@index([distrito])
  @@index([concelho])
}

enum ProductKind {
  RAW
  INTERMEDIATE
  FINISHED
}

enum BarcodeSource {
  INTERNAL
  OPEN_FOOD_FACTS
}

model Product {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  name   String
  brand  String?
  kind   ProductKind @default(RAW)
  unit   String // unidade padrão (ex.: gr, kg, ml, un)
  active Boolean     @default(true)

  // Custo médio (média ponderada) em moeda do workspace
  avgCost Decimal? @db.Decimal(12, 2)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  inventory       Inventory?
  inventoryMovements InventoryMovement[]
  inventoryLots   InventoryLot[]
  inventoryByWarehouse InventoryByWarehouse[]
  inventoryTransfers InventoryTransfer[]
  salesOrderItems SalesOrderItem[]
  salesQuoteItems SalesQuoteItem[]
  purchases       Purchase[]
  consumptions    Consumption[]
  recipeItems     RecipeItem[]
  recipesAsFinal  Recipe[]         @relation("RecipeProductFinal")

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  purchaseOrderItems  PurchaseOrderItem[]
  deliveryItems       DeliveryItem[]
  barcodes            ProductBarcode[]
  fiscalDocumentLines FiscalDocumentLine[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ProductBarcode {
  id          String @id @default(cuid())
  workspaceId String
  productId   String

  code        String
  source      BarcodeSource @default(INTERNAL)
  externalRef String?

  createdById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([productId])
}

model Inventory {
  id          String @id @default(cuid())
  workspaceId String
  productId   String @unique
  preferredSupplierId String?

  createdById String?
  updatedById String?

  quantity Decimal  @db.Decimal(14, 3)
  minimum  Decimal? @db.Decimal(14, 3)
  reorderTarget Decimal? @db.Decimal(14, 3)
  criticality InventoryCriticality @default(MEDIUM)
  supplierLeadTimeDays Int?
  supplierMinOrderQty Decimal? @db.Decimal(14, 3)
  supplierOrderMultiple Decimal? @db.Decimal(14, 3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  preferredSupplier Client? @relation("InventoryPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([preferredSupplierId])
}

enum InventoryCriticality {
  LOW
  MEDIUM
  HIGH
}

enum InventoryMovementType {
  MANUAL_ADJUSTMENT
  PURCHASE_RECEIPT
  PURCHASE_RECEIPT_REVERSAL
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  DELIVERY_SHIPMENT
  DELIVERY_RETURN
  TRANSFER_OUT
  TRANSFER_IN
}

model Warehouse {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  name      String
  code      String @db.VarChar(32)
  active    Boolean @default(true)
  isDefault Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  inventoryBalances InventoryByWarehouse[]
  inventoryMovements InventoryMovement[]
  inventoryLots      InventoryLot[]
  transfersOut      InventoryTransfer[] @relation("InventoryTransferFromWarehouse")
  transfersIn       InventoryTransfer[] @relation("InventoryTransferToWarehouse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, code])
  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model InventoryByWarehouse {
  id          String @id @default(cuid())
  workspaceId String
  warehouseId String
  productId   String

  quantity Decimal @db.Decimal(14, 3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId])
  @@index([workspaceId])
  @@index([productId])
}

model InventoryTransfer {
  id              String @id @default(cuid())
  workspaceId     String
  productId       String
  fromWarehouseId String
  toWarehouseId   String

  createdById String?

  quantity     Decimal  @db.Decimal(14, 3)
  observations String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse @relation("InventoryTransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse @relation("InventoryTransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([productId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdAt])
}

model InventoryMovement {
  id          String @id @default(cuid())
  workspaceId String
  productId   String
  warehouseId String?
  transferId  String?

  actorUserId String?

  movementType InventoryMovementType
  quantity     Decimal               @db.Decimal(14, 3)
  unitCost     Decimal?              @db.Decimal(12, 4)

  referenceType String? @db.VarChar(64)
  referenceId   String? @db.VarChar(64)
  observations  String?

  balanceAfterGlobal    Decimal? @db.Decimal(14, 3)
  balanceAfterWarehouse Decimal? @db.Decimal(14, 3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  transfer  InventoryTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, productId, createdAt])
  @@index([workspaceId, warehouseId, createdAt])
  @@index([workspaceId, movementType, createdAt])
  @@index([transferId])
}

model InventoryLot {
  id          String @id @default(cuid())
  workspaceId String
  productId   String
  warehouseId String?
  purchaseOrderId String?
  supplierId  String?

  createdById String?
  updatedById String?

  lotCode   String   @db.VarChar(120)
  expiresAt DateTime?
  serialCodes String[] @default([])
  quantity  Decimal  @db.Decimal(14, 3)
  receivedAt DateTime @default(now())
  notes     String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplier  Client?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, productId])
  @@index([workspaceId, warehouseId])
  @@index([workspaceId, expiresAt])
  @@index([purchaseOrderId])
  @@index([supplierId])
}

model InventoryLotEvent {
  id          String @id @default(cuid())
  workspaceId String
  productId   String
  warehouseId String?
  lotId       String?

  eventType String   @db.VarChar(64)
  quantity  Decimal  @db.Decimal(14, 3)
  serialCodes String[] @default([])

  referenceType String? @db.VarChar(64)
  referenceId   String? @db.VarChar(191)
  notes         String?

  createdAt DateTime @default(now())

  @@index([workspaceId, productId, createdAt])
  @@index([workspaceId, lotId, createdAt])
  @@index([workspaceId, referenceType, referenceId, createdAt])
}

model Purchase {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  productId    String
  date         DateTime @default(now())
  quantity     Decimal  @db.Decimal(14, 3)
  cost         Decimal? @db.Decimal(12, 2)
  supplier     String?
  observations String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  financialEntries FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([productId])
  @@index([date])
}

model Consumption {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  date      DateTime @default(now())
  productId String
  quantity  Decimal  @db.Decimal(14, 3)

  salesOrderId String?
  recipeId     String?
  observations String?

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  recipe     Recipe?     @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  financialEntries FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([productId])
  @@index([date])
  @@index([salesOrderId])
  @@index([recipeId])
}

model Recipe {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  productId    String // produto final
  yieldQty     Decimal? @db.Decimal(14, 3)
  observations String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation("RecipeProductFinal", fields: [productId], references: [id], onDelete: Restrict)

  items        RecipeItem[]
  consumptions Consumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([productId])
}

model RecipeItem {
  id        String @id @default(cuid())
  recipeId  String
  productId String // insumo

  createdById String?
  updatedById String?

  quantity Decimal @db.Decimal(14, 3)

  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([recipeId, productId])
  @@index([recipeId])
  @@index([productId])
}

enum FinancialEntryType {
  IN
  OUT
}

enum FinancialEntryStatus {
  PLANNED
  PAID
}

model FinancialAccount {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  name   String
  kind   String  @default("CASH") // CASH | BANK | CARD | OTHER
  active Boolean @default(true)

  openingBalance Decimal? @db.Decimal(12, 2)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FinancialCategory {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  name   String
  type   FinancialEntryType
  active Boolean            @default(true)

  parentId String?
  parent   FinancialCategory?  @relation("FinancialCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children FinancialCategory[] @relation("FinancialCategoryParent")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name, type])
  @@index([workspaceId])
  @@index([type])
}

model CostCenter {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  name   String
  active Boolean @default(true)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model WorkspaceSequence {
  workspaceId String
  key         String
  next        Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
  @@index([workspaceId])
}

enum AuditCategory {
  CRUD
  PERMISSIONS
  AUTH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  GRANT
  REVOKE
}

model WorkspaceSetting {
  workspaceId String
  key         String
  value       Json

  updatedById String?
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
  @@index([workspaceId])
}

// ============================
// Campos personalizados (custom fields)
// ============================

enum CustomFieldType {
  STRING
  NUMBER
  CURRENCY
  DATE
  BOOLEAN
  SELECT
}

model CustomFieldDefinition {
  id          String @id @default(cuid())
  workspaceId String

  // Objeto alvo (registry em src/lib/custom-fields/registry.ts), ex.: "PRODUCT", "CLIENT"
  entity String @db.VarChar(64)
  // Slug estável gerado do label, imutável depois de criado
  key    String @db.VarChar(64)
  label  String @db.VarChar(120)
  type   CustomFieldType

  required Boolean  @default(false)
  active   Boolean  @default(true)
  helpText String?  @db.VarChar(400)
  options  String[] @default([]) // usado quando type = SELECT
  order    Int      @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, entity, key])
  @@index([workspaceId, entity])
}

model CustomFieldValue {
  id          String @id @default(cuid())
  workspaceId String
  fieldId     String
  entityId    String // id do registro do objeto alvo

  value Json? // string | number | boolean; formatação/validação pelo type da definição

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  field     CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityId])
  @@index([workspaceId, entityId])
}

model AuditEvent {
  id          String @id @default(cuid())
  workspaceId String

  category AuditCategory
  action   AuditAction

  // Actor (who performed the action)
  actorUserId String?

  // Optional target user (e.g. permission changes)
  targetUserId String?

  // Optional target entity (CRUD)
  entityType String?
  entityId   String?

  // A short message used in lists
  summary String?

  meta Json?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  changes AuditEventChange[]

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, category, createdAt])
  @@index([workspaceId, actorUserId, createdAt])
  @@index([workspaceId, entityType, entityId, createdAt])
}

model AuditEventChange {
  id      String @id @default(cuid())
  eventId String

  field String
  from  Json?
  to    Json?

  event AuditEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, field])
}

enum AuditOutboxStatus {
  PENDING
  PROCESSING
  FAILED
}

model AuditOutbox {
  id          String @id @default(cuid())
  workspaceId String

  payload Json

  status    AuditOutboxStatus @default(PENDING)
  attempts  Int               @default(0)
  lastError String?

  availableAt DateTime @default(now())
  lockedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status, availableAt])
  @@index([createdAt])
}

model FinancialEntry {
  id          String @id @default(cuid())
  workspaceId String

  // Human-friendly sequential code (e.g. FIN-0000000001) unique per workspace
  code String? @db.VarChar(16)

  // Human-friendly name/title for the entry (used in UI)
  name String? @db.VarChar(200)

  createdById String?
  updatedById String?

  // Competência (quando ocorreu) vs pagamento (quando efetivou)
  competenceDate DateTime  @default(now())
  paidAt         DateTime?

  type   FinancialEntryType
  status FinancialEntryStatus @default(PAID)

  accountId    String
  categoryId   String?
  costCenterId String?

  value        Decimal @db.Decimal(12, 2)
  observations String?

  salesOrderId    String?
  purchaseId      String?
  purchaseOrderId String?
  consumptionId   String?

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account    FinancialAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category   FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenter CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  salesOrder    SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  purchase      Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  consumption   Consumption?   @relation(fields: [consumptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([competenceDate])
  @@index([paidAt])
  @@index([type])
  @@index([status])
  @@index([accountId])
  @@index([categoryId])
  @@index([costCenterId])
  @@index([salesOrderId])
  @@index([purchaseId])
  @@index([purchaseOrderId])
  @@index([consumptionId])
}

enum PayableStatus {
  PLANNED
  ACCRUED
  PAID
  CANCELLED
}

model Payable {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  purchaseOrderId String
  supplierId      String?

  status PayableStatus @default(PLANNED)

  competenceDate DateTime @default(now())
  receivedAt     DateTime?
  paidAt         DateTime?

  plannedAmount Decimal @db.Decimal(12, 2)
  accruedAmount Decimal @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal @default(0) @db.Decimal(12, 2)

  observations String?

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplier      Client?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([purchaseOrderId])
  @@index([workspaceId])
  @@index([supplierId])
  @@index([status])
  @@index([competenceDate])
  @@index([receivedAt])
  @@index([paidAt])
}

enum ApprovalEntityType {
  PURCHASE_ORDER
  SALES_ORDER
  SALES_QUOTE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id          String @id @default(cuid())
  workspaceId String

  entityType ApprovalEntityType
  entityId   String
  reason     String
  policyKey  String

  requestedById String?
  decidedById   String?

  status     ApprovalStatus @default(PENDING)
  amount     Decimal? @db.Decimal(12, 2)
  decidedAt  DateTime?
  decisionNote String?

  salesOrderId    String?
  purchaseOrderId String?
  salesQuoteId    String?

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy    User?          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy      User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  salesOrder     SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  salesQuote     SalesQuote?    @relation(fields: [salesQuoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([requestedById])
  @@index([decidedById])
}

// NextAuth models (Prisma schema from Auth.js/NextAuth docs)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model EmailOutbox {
  id String @id @default(cuid())

  to      String
  subject String
  text    String
  html    String?

  status    EmailOutboxStatus @default(PENDING)
  attempts  Int               @default(0)
  lastError String?

  availableAt DateTime @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?

  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@index([createdAt])
}

enum ExportJobKind {
  SALES_ORDERS_CSV
  SALES_ORDERS_PDF
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model ExportJob {
  id String @id @default(cuid())

  workspaceId  String
  requestedById String?

  kind   ExportJobKind
  status ExportJobStatus @default(PENDING)

  params      String?
  currency    String?
  fileName    String?
  contentType String?
  storageKey  String?
  rowCount    Int?
  truncated   Boolean?
  error       String?

  availableAt DateTime @default(now())
  lockedAt    DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status, availableAt])
  @@index([requestedById, createdAt])
  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================
// Deliveries + Receivables + Payments (Sales flow)
// ============================

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum DeliveryStatus {
  PLANNED
  PICKING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model Delivery {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  salesOrderId String
  clientId     String?

  status DeliveryStatus @default(PLANNED)

  method DeliveryMethod @default(PICKUP)

  plannedAt   DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?

  carrier      String?
  trackingCode String?
  trackingUrl  String?
  observations String?

  // Snapshot do endereço de entrega (quando method=DELIVERY)
  addressCountry    String? @db.VarChar(2)
  addressPostalCode String? @db.VarChar(16)
  addressState      String? @db.VarChar(80)
  addressCity       String? @db.VarChar(120)
  addressDistrict   String? @db.VarChar(120)
  addressStreet     String? @db.VarChar(180)
  addressNumber     String? @db.VarChar(40)
  addressComplement String? @db.VarChar(120)
  addressNotes      String? @db.VarChar(500)

  // Valor a faturar por esta expedição (MVP). Evita precisar de preço por item agora.
  value Decimal? @db.Decimal(12, 2)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  items      DeliveryItem[]
  receivable Receivable?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  fiscalDocuments FiscalDocument[]

  @@index([workspaceId])
  @@index([salesOrderId])
  @@index([clientId])
  @@index([status])
  @@index([plannedAt])
  @@index([shippedAt])
  @@index([deliveredAt])
}

model DeliveryItem {
  id         String @id @default(cuid())
  deliveryId String
  productId  String

  createdById String?
  updatedById String?

  quantity Decimal @db.Decimal(14, 3)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([deliveryId, productId])
  @@index([deliveryId])
  @@index([productId])
}

enum ReceivableStatus {
  OPEN
  PAID
  CANCELLED
}

model Receivable {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  salesOrderId String
  deliveryId   String  @unique
  clientId     String?

  status ReceivableStatus @default(OPEN)

  issuedAt DateTime  @default(now())
  dueAt    DateTime?

  value Decimal @db.Decimal(12, 2)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  delivery   Delivery   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  applications PaymentApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([salesOrderId])
  @@index([clientId])
  @@index([status])
  @@index([issuedAt])
  @@index([dueAt])
}

enum PaymentMethod {
  CASH
  TRANSFER
  MBWAY
  PIX
  CARD
  OTHER
}

enum PaymentStatus {
  RECEIVED
  REFUNDED
  FAILED
}

model Payment {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  salesOrderId String
  clientId     String?

  method PaymentMethod
  status PaymentStatus @default(RECEIVED)

  receivedAt DateTime @default(now())

  value Decimal @db.Decimal(12, 2)

  reference    String?
  proofUrl     String?
  observations String?

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  applications PaymentApplication[]
  refunds      Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([salesOrderId])
  @@index([clientId])
  @@index([method])
  @@index([status])
  @@index([receivedAt])
}

model PaymentApplication {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  paymentId    String
  receivableId String

  appliedAt DateTime @default(now())
  value     Decimal  @db.Decimal(12, 2)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment    Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@unique([paymentId, receivableId])
  @@index([workspaceId])
  @@index([paymentId])
  @@index([receivableId])
  @@index([appliedAt])
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  DONE
  FAILED
}

enum RefundMethod {
  CARD_REVERSAL
  TRANSFER
  PIX
  MBWAY
  CASH
  OTHER
}

model Refund {
  id          String @id @default(cuid())
  workspaceId String

  createdById String?
  updatedById String?

  salesOrderId String
  clientId     String?

  paymentId String?

  status RefundStatus @default(REQUESTED)
  method RefundMethod

  requestedAt DateTime  @default(now())
  completedAt DateTime?

  value Decimal @db.Decimal(12, 2)

  reason       String?
  reference    String?
  proofUrl     String?
  observations String?

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  payment    Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([salesOrderId])
  @@index([clientId])
  @@index([paymentId])
  @@index([status])
  @@index([requestedAt])
  @@index([completedAt])
}

// ============================
// Fiscal (multinational skeleton)
// ============================

model Company {
  id          String @id @default(cuid())
  workspaceId String

  // Group/legal entity container. Branches (HQ/filiais) issue documents.
  legalName String
  tradeName String?
  country   CountryCode

  createdById String?
  updatedById String?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branches  CompanyBranch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model CompanyBranch {
  id          String @id @default(cuid())
  workspaceId String
  companyId   String

  type CompanyBranchType @default(HQ)
  code String            @db.VarChar(32)

  country   CountryCode
  taxIdType TaxIdType
  taxId     String      @db.VarChar(32)

  // Brazil-specific (optional until BR is configured)
  brIe  String? @db.VarChar(32)
  brCrt Int?

  // NFe numbering is reserved on issuance (not on draft creation)
  brNfeSeries      String?           @db.VarChar(16)
  brNfeNextNumber  Int?
  brNfeEnvironment BrNfeEnvironment?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String? @db.VarChar(32)
  postalCode   String? @db.VarChar(16)

  createdById String?
  updatedById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fiscalDocuments FiscalDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, companyId, code])
  @@index([workspaceId])
  @@index([companyId])
  @@index([country])
}

model FiscalDocument {
  id          String @id @default(cuid())
  workspaceId String
  branchId    String

  country CountryCode
  kind    FiscalDocumentKind   @default(SALE)
  status  FiscalDocumentStatus @default(DRAFT)

  // Optional source references (supports invoicing without delivery)
  salesOrderId String?
  deliveryId   String?

  // Party snapshot (keep immutable even if client changes later)
  clientId           String?
  clientName         String?
  clientTaxIdType    TaxIdType?
  clientTaxId        String?      @db.VarChar(32)
  clientAddressLine1 String?
  clientAddressLine2 String?
  clientCity         String?
  clientState        String?      @db.VarChar(32)
  clientPostalCode   String?      @db.VarChar(16)
  clientCountry      CountryCode?

  // Totals (taxes are country-specific and may be expanded later)
  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  taxesTotal Decimal @default(0) @db.Decimal(12, 2)
  total      Decimal @default(0) @db.Decimal(12, 2)

  createdById String?
  updatedById String?

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branch     CompanyBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  delivery   Delivery?     @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  client     Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  lines FiscalDocumentLine[]
  brNfe BrNfe?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([branchId])
  @@index([status])
  @@index([kind])
  @@index([salesOrderId])
  @@index([deliveryId])
  @@index([clientId])
}

model FiscalDocumentLine {
  id          String @id @default(cuid())
  workspaceId String
  documentId  String

  // PRODUCT or SERVICE line (simple string for now)
  lineType String @db.VarChar(16)

  productId   String?
  description String

  qty      Decimal @default(0) @db.Decimal(12, 3)
  unit     String? @db.VarChar(16)
  price    Decimal @default(0) @db.Decimal(12, 4)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  // Country-specific tax breakdown (skeleton)
  taxesJson Json?

  createdById String?
  updatedById String?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product   Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([documentId])
  @@index([productId])
}

model BrNfe {
  id          String @id @default(cuid())
  workspaceId String
  documentId  String @unique

  environment BrNfeEnvironment @default(HOMOLOGATION)
  status      BrNfeStatus      @default(DRAFT)

  series    String? @db.VarChar(16)
  number    Int?
  accessKey String? @db.VarChar(64)

  xmlDraft      String?
  xmlAuthorized String?
  protocol      String?
  rejection     String?

  createdById String?
  updatedById String?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([status])
}

