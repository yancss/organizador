# Database
# For Postgres (recommended):
#   postgres://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/organizador?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# App URL (used to build password reset links)
APP_URL="http://localhost:3000"

# Email (recommended): Resend
# Create an API key at https://resend.com
RESEND_API_KEY=""
# On Resend free/dev, you may need to use "onboarding@resend.dev" as from.
RESEND_FROM="Guardian <onboarding@resend.dev>"

# Email (alternative): SMTP
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Guardian <no-reply@yourdomain.com>"
