{
  "name": "guardian",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "prisma generate && next build",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:demo:uat": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\run-seed-demo-with-envfile.ps1 -EnvFile .env.uat",
    "ensure:support-user:uat": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\run-ensure-support-user-with-envfile.ps1 -EnvFile .env.uat",
    "provision:uat": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\provision-uat.ps1",
    "provision:uat:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\provision-uat.ps1 -WithDemo",
    "set:support-password:uat": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\run-set-user-password-with-envfile.ps1 -EnvFile .env.uat -Email support.guardian.app@gmail.com -Password 123456",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:generate:fix": "powershell -ExecutionPolicy Bypass -File scripts\\fix-prisma-eperm.ps1",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:uat": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\run-prisma-migrate-with-envfile.ps1 -EnvFile .env.uat",
    "prisma:studio": "prisma studio",
    "bootstrap": "node scripts/bootstrap-support.js",
    "provision:db": "node scripts/provision-db.js",
    "seed:permissions": "node scripts/seed-permissions.mjs",
    "audit:cleanup": "node -e \"fetch('http://localhost:3000/api/cron/audit-cleanup').then(r=>r.json()).then(console.log)\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.15.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.5",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-international-phone": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "jsdom": "^29.0.1",
    "prisma": "^6.15.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  }
}
